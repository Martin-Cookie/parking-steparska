# Vzor nastavení pro poptávkový formulář.
# Tyto hodnoty NEPATŘÍ do gitu — vyplňte je ve Vercelu:
# Project → Settings → Environment Variables
# Po přidání je nutné znovu nasadit (Deployments → … → Redeploy),
# jinak se nové proměnné nepoužijí.

# API klíč z https://resend.com (zdarma 3 000 e-mailů měsíčně)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Kam se mají poptávky posílat
CONTACT_TO=079114@gmail.com

# Odesílatel.
#
# Bez ověřené domény použijte testovací adresu Resendu:
CONTACT_FROM=onboarding@resend.dev
#
# POZOR: onboarding@resend.dev smí posílat JEN na e-mail, kterým je účet
# u Resendu registrovaný. CONTACT_TO tedy musí být stejná adresa, jinak
# Resend odpoví chybou 403 a poptávka nedojde.
#
# Až ověříte doménu parking-steparska.cz v Resendu, přepněte na:
# CONTACT_FROM=web@parking-steparska.cz
# Pak už může být CONTACT_TO libovolná adresa.
